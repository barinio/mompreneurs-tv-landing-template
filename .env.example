# Required for all deployments (template + clones)
ADMIN_PASSWORD=changeme

# GitHub Personal Access Token (repo scope: read/write contents, fork repos)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub username or org that owns THIS repo
GITHUB_OWNER=your-github-username

# The name of THIS repo (e.g. "tv-landing-template" for the template, "client-sarah-tv" for a clone)
GITHUB_REPO=tv-landing-template

# Vercel API token (required for creating new cloned projects — template repo only)
# NOTE: prefix is DEPLOY_ because Vercel reserves VERCEL_* for system env vars
DEPLOY_VERCEL_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Optional: Vercel team ID (leave blank for personal account)
DEPLOY_VERCEL_TEAM_ID=

# "true" on the template repo (shows Sites Manager tab), "false" on all cloned repos
IS_TEMPLATE=true

# Vercel Blob store token for image uploads. Auto-added when you connect a Blob
# store to the project in Vercel (Storage tab). Propagated to all clones so they
# share one store. Without it, image upload returns a config error.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
